# Next.js（ローカル / Vercel）で使う環境変数
# 値は空のままでもローカル起動できる（サンプル表示）。必要なものだけ埋める。

# Neon の接続文字列（任意）
# 空: ローカル JSON / サンプル表示
# 入れる: その URL 先の DB を読む（本番と同じ値なら本番 DB）
# 例: postgresql://USER:PASSWORD@HOST/DB?sslmode=require
DATABASE_URL=

# /api/ingest 用の秘密文字列
# 初回は自分で長い乱数を作ってよい。Vercel / GAS と同じ値に揃える。
# 空のままでは ingest API は動かない（画面閲覧だけなら不要）
INGEST_SECRET=

# X 候補の自動収集（workers/x-pickup）。値はここに書かず、環境変数か gitignore された .env.local に置く。
# 手順とローテーションは workers/x-pickup/README.md。
# APP_BASE_URL=https://yoyaku-wakaru.vercel.app
# BASE_URL= は APP_BASE_URL が空のときの別名
# X_STORAGE_STATE_PATH=workers/x-pickup/secrets/x-storage-state.json
# X_AUTH_TOKEN=
# X_CT0=
# X_PICKUP_DRY_RUN=1
# X_PICKUP_AUTO_APPROVE=0
# X_PICKUP_LIMIT=15
# X_PICKUP_MAX_AGE_HOURS=48
